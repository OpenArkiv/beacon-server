# Copy to .env for local dev. Never commit a real .env.

# --- Required ---

# Salt used by PBKDF2 to derive the per-device server wallet from the
# device identifier (Ed25519 pubkey hex or EVM address). High-entropy.
# Rotating it changes every derived wallet, so generate once per
# environment and keep stable.
SERVER_SALT=replace-with-a-long-random-string

# Pinata API credentials (https://pinata.cloud) for IPFS file uploads.
PINATA_API_KEY=
PINATA_SECRET_KEY=

# --- Required when using docker-compose + Caddy on EC2 ---

# DNS name pointed at this EC2 instance. Caddy will auto-provision a
# Let's Encrypt cert for this name on first start.
DOMAIN=beacon.example.com

# Contact email for Let's Encrypt ACME registration.
ACME_EMAIL=ops@example.com

# --- Optional ---

# HTTP port. Container exposes 3000 by default.
PORT=3000

# Comma-separated allowed CORS origins. Defaults to "*"; set to your
# client's origin(s) in production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Arkiv JSON-RPC endpoint. Defaults to Mendoza testnet.
# ARKIV_RPC_URL=https://mendoza.hoodi.arkiv.network/rpc

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Standard Node convention; set to "production" for prod deploys.
NODE_ENV=development

# Rate limit on /api/device/*. Defaults to 30 requests / 60s per IP.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# RATE_LIMIT_DISABLED=true   # only for local load testing

# --- Dev/demo only — DO NOT enable in production ---

# When "true", clients may pass bypassSignature=true on /upload and /verify
# to skip signature verification. The server then derives its
# Arkiv-paying wallet from MOCK_DEVICE_PRIVATE_KEY for every such request.
# Anyone with the URL becomes the mock device — leave OFF in prod.
ALLOW_BYPASS_SIGNATURE=false

# Override the mock device private key used when bypass is enabled.
# MOCK_DEVICE_PRIVATE_KEY=0x...
